{
  "name": "dsh-diy-skin",
  "version": "1.30.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chang-An2002/dsh-diy-skin.git",
    "directory": "dsh-diy-skin"
  },
  "description": "DSH皮肤插件，可添加壁纸及装饰图片（支持gif），自定义UI配色，余额显示功能，适用于桌面端应用。",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "dsh",
    "harness",
    "cordis",
    "plugin",
    "theme",
    "skin",
    "wallpaper",
    "background"
  ],
  "icon": "./icon.svg",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "client.js",
    "index.js",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "THEME-SURFACE.md",
    "KNOB-REACH.md",
    "DESIGN.md"
  ],
  "scripts": {
    "test": "node test/client.test.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
